<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane fx:id="hudPane" pickOnBounds="false" prefHeight="576.0" prefWidth="768.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg126598.controller.PlayerController">
    <children>
        <VBox fx:id="stats" layoutX="20.0" layoutY="20.0" spacing="6.0">
            <children>
            <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="200.0" spacing="4.0">
               <children>
                  <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../player/heart.png" />
                     </image>
                  </ImageView>
                      <ProgressBar fx:id="hpBar" prefHeight="16.0" prefWidth="200.0" progress="1.0" styleClass="hp-bar" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="200.0" spacing="4.0">
               <children>
                  <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../player/shield.png" />
                     </image>
                  </ImageView>
                  <ProgressBar fx:id="defenseBar" prefHeight="12.0" prefWidth="100.0" progress="1.0" styleClass="defense-bar" />
               </children>
            </HBox>
            </children>
        </VBox>
    </children>
</Pane>
